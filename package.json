{
  "name": "vue3-social-sharing",
  "version": "1.4.1",
  "description": "Vue 3 social sharing plugin",
  "repository": "https://github.com/hedint/vue3-social-sharing",
  "keywords": [
    "vue",
    "vue 3",
    "vue3",
    "vue plugin",
    "social sharing",
    "social share",
    "social sharing plugin",
    "vue social sharing",
    "vue social share",
    "vue 3 social sharing",
    "vue 3 social sharing plugin"
  ],
  "type": "module",
  "author": "Vyacheslav Volodin<vachvol@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "types": "vue-tsc",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" \"playground/src/**/*.{css,scss,vue}\"",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:style -- --fix",
    "lint": "npm run lint:js && npm run lint:style",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "pack:dry-run": "npm pack --dry-run",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release:check": "npm run lint && npm run test && npm run build && npm run pack:dry-run"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@changesets/cli": "^2.31.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "sass": "^1.99.0",
    "stylelint": "^17.11.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  }
}
